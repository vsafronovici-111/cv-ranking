# IntelliJ IDEA
.idea/
**/.idea/
*.iml

# Python virtual environments
.venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]   
*.pyc


# Local secrets/config (config/local.env is tracked directly; keep prod's
# .env.example template tracked instead of the real prod secrets)
config/prod.env

# Personal override on top of config/local.env (same idea as
# .claude/settings.local.json below) - per-developer, never committed
config/local.env.local

# Docker volumes (keep the folder tracked via .gitkeep, ignore its contents)
docker/volume/**
!docker/volume/**/
!docker/volume/**/.gitkeep

# VS Code
.vscode/

# Node / web app
web/node_modules/
web/dist/

# Claude Code: project settings.json is shared/committed, settings.local.json is per-developer
.claude/settings.local.json


