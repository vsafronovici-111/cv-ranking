# IntelliJ IDEA
.idea/
**/.idea/
*.iml

# Python virtual environments
.venv/
**/.venv/

# Local secrets/config (keep the .env.example templates tracked)
config/local.env
config/prod.env

# Docker volumes (keep the folder tracked via .gitkeep, ignore its contents)
docker/volume/**
!docker/volume/**/
!docker/volume/**/.gitkeep


