# IntelliJ IDEA
.idea/
**/.idea/
*.iml

# Python virtual environments
.venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]   
*.pyc


# Local secrets/config (keep the .env.example templates tracked)
config/local.env
config/prod.env

# Docker volumes (keep the folder tracked via .gitkeep, ignore its contents)
docker/volume/**
!docker/volume/**/
!docker/volume/**/.gitkeep

# VS Code
.vscode/

# Claude Code: project settings.json is shared/committed, settings.local.json is per-developer
.claude/settings.local.json


