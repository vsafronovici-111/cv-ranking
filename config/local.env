# Local development environment (Ollama). Auto-loaded by pydantic-settings;
# edit in place for your own local overrides, or export these as shell vars.
#
# Usage:
#   set -a; source config/local.env; set +a
#   PYTHONPATH=src python3 -m cv_ranker ingest --cv-folder ...
#   PYTHONPATH=src python3 -m cv_ranker process --requirements "..."
#   PYTHONPATH=src python3 -m cv_ranker report

CV_RANKER_ENV=local
CV_RANKER_BASE_URL=http://localhost:11434/v1
CV_RANKER_API_KEY=ollama
CV_RANKER_MODEL=qwen3:14b
CV_RANKER_TIMEOUT_SECONDS=150

# Root logger level (DEBUG/INFO/WARNING/ERROR/CRITICAL). Verbose by default
# in local dev; centralized log shipping in production reads this same var.
CV_RANKER_LOG_LEVEL=INFO

# Postgres connection for the CV processing queue (database "cvranker").
CV_RANKER_DB_DSN=postgresql://postgres:postgres@localhost:5432/cvranker

# Kafka broker used to publish/consume chat message events.
CV_RANKER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis used for pub/sub notifications (e.g. the "ai-model-response" channel).
CV_RANKER_REDIS_URL=redis://localhost:6379

# Qdrant (vector DB for CV embeddings) — key applies to both REST (6333) and
# gRPC (6334); must match QDRANT__SERVICE__API_KEY in docker/docker-compose.yml.
# Generate your own with: openssl rand -hex 32
CV_RANKER_QDRANT_URL=http://localhost:6333
CV_RANKER_QDRANT_API_KEY=9a5e52a320a6b45747bb8eb5a4297c9d25cb054200cda5090da8297f45d825f5

# Embedding model (OpenAI-compatible /v1/embeddings endpoint, same as the chat API above).
CV_RANKER_EMBEDDING_BASE_URL=http://localhost:11434/v1
CV_RANKER_EMBEDDING_API_KEY=ollama
CV_RANKER_EMBEDDING_MODEL=qwen3-embedding:4b
CV_RANKER_EMBEDDING_TIMEOUT_SECONDS=90

