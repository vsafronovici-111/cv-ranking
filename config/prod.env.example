# Production environment (vLLM OpenAI-compatible server).
# Copy to config/prod.env, fill in real values, and DO NOT commit the copy.
#
# Usage:
#   set -a; source config/prod.env; set +a
#   PYTHONPATH=src python3 -m cv_ranker --env prod ingest --cv-folder ...
#   PYTHONPATH=src python3 -m cv_ranker --env prod process --requirements "..."

CV_RANKER_ENV=prod
CV_RANKER_BASE_URL=https://your-vllm-host:8000/v1
CV_RANKER_API_KEY=replace-with-real-key
CV_RANKER_MODEL=Qwen/Qwen3-14B
CV_RANKER_TIMEOUT_SECONDS=120

# Postgres connection for the CV processing queue (database "cvranker").
CV_RANKER_DB_DSN=postgresql://replace-with-real-dsn

