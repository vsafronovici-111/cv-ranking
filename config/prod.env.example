# Production environment (vLLM OpenAI-compatible server).
# Copy to config/prod.env, fill in real values, and DO NOT commit the copy.
#
# Usage:
#   set -a; source config/prod.env; set +a
#   PYTHONPATH=src python3 -m cv_ranker --env prod ingest --cv-folder ...
#   PYTHONPATH=src python3 -m cv_ranker --env prod process --requirements "..."

CV_RANKER_ENV=prod
CV_RANKER_BASE_URL=https://your-vllm-host:8000/v1
CV_RANKER_API_KEY=replace-with-real-key
CV_RANKER_MODEL=Qwen/Qwen3-14B
CV_RANKER_TIMEOUT_SECONDS=120

# Root logger level (DEBUG/INFO/WARNING/ERROR/CRITICAL). Keep at INFO (or
# WARNING) in production; centralized log shipping reads this same var.
CV_RANKER_LOG_LEVEL=INFO

# Postgres connection for the CV processing queue (database "cvranker").
CV_RANKER_DB_DSN=postgresql://replace-with-real-dsn

# Kafka broker used to publish/consume chat message events.
CV_RANKER_KAFKA_BOOTSTRAP_SERVERS=replace-with-real-kafka-bootstrap-servers

# Redis used for pub/sub notifications (e.g. the "ai-model-response" channel).
CV_RANKER_REDIS_URL=replace-with-real-redis-url

# Qdrant (vector DB for CV embeddings)
CV_RANKER_QDRANT_URL=https://your-qdrant-host:6333
CV_RANKER_QDRANT_API_KEY=replace-with-real-key

# Embedding model (OpenAI-compatible /v1/embeddings endpoint, same as the chat API above).
CV_RANKER_EMBEDDING_BASE_URL=https://your-vllm-host:8000/v1
CV_RANKER_EMBEDDING_API_KEY=replace-with-real-key
CV_RANKER_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
CV_RANKER_EMBEDDING_TIMEOUT_SECONDS=90

